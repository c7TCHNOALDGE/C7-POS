rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function prof() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function active() { return signed() && exists(/databases/$(db)/documents/users/$(request.auth.uid)) && prof().active == true; }
    function admin() { return active() && prof().role == 'admin'; }
    function own() { return request.resource.data.cashierId == request.auth.uid; }

    // أول حساب يدخل يصبح المدير، مرة واحدة فقط
    match /meta/bootstrap {
      allow read: if signed();
      allow create: if signed() && getAfter(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /users/{uid} {
      allow read: if admin() || (signed() && request.auth.uid == uid);
      allow create: if admin() || (signed() && request.auth.uid == uid
                     && !exists(/databases/$(db)/documents/meta/bootstrap)
                     && existsAfter(/databases/$(db)/documents/meta/bootstrap));
      allow update, delete: if admin();
    }
    match /settings/{id}  { allow read: if active(); allow write: if admin(); }
    match /counters/{id}  { allow read, write: if active(); }

    // الموظف يقرأ الأصناف ويُنقص الكمية عند البيع فقط
    match /products/{id} {
      allow read: if active();
      allow create, delete: if admin();
      allow update: if admin() || (active() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']));
    }
    match /customers/{id} {
      allow read, create: if active();
      allow update: if admin() || (active() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance']));
      allow delete: if admin();
    }
    // الموظف يرى مبيعاته فقط ولا يعدّل أو يحذف فاتورة
    match /sales/{id} {
      allow read: if admin() || (active() && resource.data.cashierId == request.auth.uid);
      allow create: if active() && own();
      allow update, delete: if admin();
    }
    match /shifts/{id} {
      allow read: if admin() || (active() && resource.data.cashierId == request.auth.uid);
      allow create: if active() && own();
      allow update: if admin() || (active() && resource.data.cashierId == request.auth.uid && resource.data.status == 'open');
      allow delete: if admin();
    }
    // المشتريات والموردون والمصروفات والدفعات والتسويات: للإدارة فقط
    match /{col}/{id} { allow read, write: if admin(); }
  }
}
